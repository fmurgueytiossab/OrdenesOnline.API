@host = https://localhost:7213
@token = REEMPLAZAR_ACCESS_TOKEN

### Login
POST {{host}}/api/Representante/login
Content-Type: application/json

{
  "correo": "representante@example.com",
  "password": "REEMPLAZAR"
}

### Perfil autenticado
GET {{host}}/api/Representante/me
Authorization: Bearer {{token}}

### Valores
GET {{host}}/api/Valor
Authorization: Bearer {{token}}

### Solicitar recuperación de contraseña
POST {{host}}/api/Email/send-validation
Content-Type: application/json

{
  "email": "representante@example.com"
}

### Crear propuesta
POST {{host}}/api/Propuesta
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "cosabcli": "C001",
  "tipo": "Compra",
  "tipoOrden": "Mercado",
  "cantidad": 10,
  "instrumento": "ABC",
  "precio": null,
  "monto": null,
  "mercado": "Local",
  "moneda": "PEN",
  "vigencia": "Día"
}

### Crear propuesta para cliente y enviarle el resumen por correo
POST {{host}}/api/PropuestaCliente
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "correoCliente": "cliente@example.com",
  "cosabcli": "C001",
  "tipo": "Compra",
  "tipoOrden": "Mercado",
  "cantidad": 10,
  "instrumento": "ABC",
  "precio": null,
  "monto": null,
  "mercado": "BVL",
  "moneda": "PEN",
  "vigencia": "Día"
}

### Validar token y obtener el resumen para revisión
POST {{host}}/api/PropuestaCliente/revision/validar
Content-Type: application/json

{
  "token": "REEMPLAZAR_TOKEN_REVISION"
}

### Aceptar o cancelar una propuesta (el token se consume)
POST {{host}}/api/PropuestaCliente/revision
Content-Type: application/json

{
  "token": "REEMPLAZAR_TOKEN_REVISION",
  "estado": "Aceptado"
}
